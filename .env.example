# Copying this file is optional. UAF never loads secrets into SQLite.
# Recommended Gemini onboarding: `uaf setup` stores one key in the OS vault.
# Environment variables are an alternative and take precedence; never commit .env.
UAF_HOME=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional local endpoint; local inference is disabled until explicitly configured.
UAF_OLLAMA_URL=http://127.0.0.1:11434
